generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ============================================
// USER & AUTH TABLES
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatarUrl     String?   @map("avatar_url")
  provider      String?   // 'google', 'github'
  providerId    String?   @map("provider_id")
  role          String    @default("user") // 'user', 'admin'
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  chatSessions  ChatSession[]
  mcpCredentials McpCredential[]
  analyticsEvents AnalyticsEvent[]

  @@map("users")
}

model AdminCredential {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  totpSecret    String    @map("totp_secret")
  allowedIps    String[]  @map("allowed_ips")
  lastLoginAt   DateTime? @map("last_login_at")
  lastLoginIp   String?   @map("last_login_ip")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("admin_credentials")
}

model Session {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  token         String    @unique
  expiresAt     DateTime  @map("expires_at")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// CONTENT TABLES
// ============================================

model Category {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  icon          String?
  color         String?
  isVisible     Boolean   @default(true) @map("is_visible")
  displayOrder  Int       @default(0) @map("display_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  projects      Project[]

  @@map("categories")
}

model Project {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  description     String?
  longDescription String?   @map("long_description")
  techStack       String[]  @map("tech_stack")
  categoryId      String    @map("category_id")
  githubUrl       String?   @map("github_url")
  liveUrl         String?   @map("live_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  images          String[]
  isFeatured      Boolean   @default(false) @map("is_featured")
  isPublished     Boolean   @default(true) @map("is_published")
  githubStars     Int       @default(0) @map("github_stars")
  githubForks     Int       @default(0) @map("github_forks")
  displayOrder    Int       @default(0) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category        Category  @relation(fields: [categoryId], references: [id])

  @@map("projects")
}

model Skill {
  id              String    @id @default(uuid())
  name            String
  category        String    // 'frontend', 'backend', 'devops', 'ai', 'database', 'other'
  proficiency     Int       @default(50) // 1-100
  iconUrl         String?   @map("icon_url")
  yearsExperience Float?    @map("years_experience")
  isFeatured      Boolean   @default(false) @map("is_featured")
  displayOrder    Int       @default(0) @map("display_order")

  @@map("skills")
}

model Experience {
  id              String    @id @default(uuid())
  company         String
  role            String
  description     String?
  responsibilities String[] 
  techStack       String[]  @map("tech_stack")
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  isCurrent       Boolean   @default(false) @map("is_current")
  companyUrl      String?   @map("company_url")
  companyLogoUrl  String?   @map("company_logo_url")
  location        String?
  displayOrder    Int       @default(0) @map("display_order")

  @@map("experience")
}

model Testimonial {
  id              String    @id @default(uuid())
  authorName      String    @map("author_name")
  authorRole      String?   @map("author_role")
  authorCompany   String?   @map("author_company")
  authorAvatarUrl String?   @map("author_avatar_url")
  content         String
  rating          Int?      // 1-5
  status          String    @default("pending") // 'pending', 'approved', 'rejected'
  source          String?   // 'agent', 'manual'
  linkedinUrl     String?   @map("linkedin_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  approvedAt      DateTime? @map("approved_at")

  @@map("testimonials")
}

// ============================================
// INQUIRY & CONTACT TABLES
// ============================================

model Inquiry {
  id            String    @id @default(uuid())
  name          String
  email         String
  company       String?
  budget        String?
  timeline      String?
  projectType   String?   @map("project_type")
  description   String
  techStack     String[]  @map("tech_stack")
  status        String    @default("new") // 'new', 'read', 'replied', 'closed'
  source        String?   // 'contact_form', 'agent', 'mcp_client'
  sessionId     String?   @map("session_id")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  chatSession   ChatSession? @relation(fields: [sessionId], references: [id])

  @@map("inquiries")
}

// ============================================
// CHAT & AI TABLES
// ============================================

model ChatSession {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")
  guestIp       String?   @map("guest_ip")
  title         String?
  status        String    @default("active") // 'active', 'archived'
  messageCount  Int       @default(0) @map("message_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  inquiries     Inquiry[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            String    @id @default(uuid())
  sessionId     String    @map("session_id")
  role          String    // 'user', 'assistant', 'tool'
  content       String
  toolName      String?   @map("tool_name")
  toolInput     Json?     @map("tool_input")
  toolOutput    Json?     @map("tool_output")
  tokensUsed    Int?      @map("tokens_used")
  latencyMs     Int?      @map("latency_ms")
  createdAt     DateTime  @default(now()) @map("created_at")

  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model McpCredential {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  serverUrl     String    @map("server_url")
  authType      String    @default("none") // 'none', 'api_key', 'oauth', 'bearer'
  encryptedToken String?  @map("encrypted_token")
  headers       Json?
  isActive      Boolean   @default(true) @map("is_active")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mcp_credentials")
}

// ============================================
// ANALYTICS TABLES
// ============================================

model AnalyticsEvent {
  id            String    @id @default(uuid())
  sessionId     String?   @map("session_id") // browser session, not chat
  userId        String?   @map("user_id")
  eventType     String    @map("event_type") // 'page_view', 'project_click', etc.
  page          String?
  referrer      String?
  country       String?
  deviceType    String?   @map("device_type") // 'desktop', 'mobile', 'tablet'
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("analytics_events")
}

// ============================================
// RESUME & EMBEDDINGS TABLES
// ============================================

model ResumeVersion {
  id            String    @id @default(uuid())
  version       String
  label         String?
  s3Url         String    @map("s3_url")
  isDefault     Boolean   @default(false) @map("is_default")
  downloadCount Int       @default(0) @map("download_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("resume_versions")
}

model EmbeddingMetadata {
  id            String    @id @default(uuid())
  sourceType    String    @map("source_type") // 'resume', 'project', 'experience', 'skill'
  sourceId      String    @map("source_id")
  chunkIndex    Int       @map("chunk_index")
  chunkText     String    @map("chunk_text")
  tokenCount    Int?      @map("token_count")
  embeddedAt    DateTime  @default(now()) @map("embedded_at")

  @@unique([sourceType, sourceId, chunkIndex])
  @@map("embeddings_metadata")
}
