{
  "info": {
    "name": "Portfolio API — Phase 1 (Auth + API Keys)",
    "description": "Tests user signup/login/logout/me (session cookie), Google/GitHub OAuth start, API key create/list/revoke, the API-key auth path, and admin login. Postman's cookie jar carries the `sid` session cookie automatically after signup/login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "email", "value": "test@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "apiKey", "value": "" },
    { "key": "apiKeyId", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "changeme123" }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "1. Signup (email/password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('returns user', () => pm.expect(j.data.user.email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Test User\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
      }
    },
    {
      "name": "2. Login (email/password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('returns user', () => pm.expect(j.data.user).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "3. Me (session cookie)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('is me', () => pm.expect(j.data.user.email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "4. Create API key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(201));",
              "const j = pm.response.json();",
              "pm.test('returns raw key once', () => pm.expect(j.data.key).to.include('pk_live_'));",
              "pm.collectionVariables.set('apiKey', j.data.key);",
              "pm.collectionVariables.set('apiKeyId', j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My laptop\",\n  \"scopes\": []\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/apikeys", "host": ["{{baseUrl}}"], "path": ["api", "apikeys"] }
      }
    },
    {
      "name": "5. List API keys",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('never leaks raw key', () => pm.expect(JSON.stringify(j)).to.not.include(pm.collectionVariables.get('apiKey')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/apikeys", "host": ["{{baseUrl}}"], "path": ["api", "apikeys"] }
      }
    },
    {
      "name": "6. Me (via API key — Bearer pk_)",
      "description": "Sends Authorization: Bearer {{apiKey}}. resolvePrincipal checks the API-key path BEFORE the cookie, so this exercises the key even though the session cookie is also present.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('resolves to same user', () => pm.expect(j.data.user.email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "7. Revoke API key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/apikeys/{{apiKeyId}}", "host": ["{{baseUrl}}"], "path": ["api", "apikeys", "{{apiKeyId}}"] }
      }
    },
    {
      "name": "8. Me (via REVOKED key — expect 401)",
      "description": "After revoke, the pk_ key fails and does NOT fall back to the cookie — so this must be 401.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 unauthorized', () => pm.expect(pm.response.code).to.eql(401));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "9. Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 ok', () => pm.expect(pm.response.code).to.eql(200));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
      }
    },
    {
      "name": "10. Me (after logout — expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 unauthorized', () => pm.expect(pm.response.code).to.eql(401));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "11. Google login (open in BROWSER)",
      "description": "OAuth is a browser redirect flow — paste {{baseUrl}}/api/auth/google into a browser, not Postman. It redirects to Google, then back to /api/auth/google/callback, then to APP_URL/dashboard with a session cookie set.",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] }
      }
    },
    {
      "name": "12. GitHub login (open in BROWSER)",
      "description": "Same as Google — open {{baseUrl}}/api/auth/github in a browser.",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/auth/github", "host": ["{{baseUrl}}"], "path": ["api", "auth", "github"] }
      }
    },
    {
      "name": "13. Admin login (existing flow)",
      "description": "Requires a seeded admin (pnpm seed:admin). Returns accessToken/refreshToken in the body (JWT).",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "admin", "login"] }
      }
    }
  ]
}
