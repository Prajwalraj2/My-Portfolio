{
  "info": {
    "name": "Portfolio API — Phase 2b (Portfolio + Guides + Blogs)",
    "description": "Public reads (portfolio, profile, guides, blogs) + admin CRUD. Run 'Admin login' first — it captures the admin JWT into {{adminToken}} used by the admin (write) requests. Requires a seeded admin: cd apps/api-gateway && pnpm seed:admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "adminEmail", "value": "admin@prajwalraj.me" },
    { "key": "adminPassword", "value": "AdminPassword123!" },
    { "key": "adminToken", "value": "" },
    { "key": "guideSlug", "value": "getting-started" },
    { "key": "blogSlug", "value": "hello-world" }
  ],
  "item": [
    {
      "name": "0. Admin login (capture JWT)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));",
        "const j = pm.response.json();",
        "if (j.data && j.data.accessToken) pm.collectionVariables.set('adminToken', j.data.accessToken);"
      ] } } ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","login"] }
      }
    },
    {
      "name": "1. Profile — PUT (admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Prajwal Raj\",\n  \"headline\": \"DevOps & AI Engineer\",\n  \"bio\": \"I build enterprise-grade systems.\",\n  \"location\": \"India\",\n  \"socials\": { \"github\": \"https://github.com/Prajwalraj2\", \"linkedin\": \"https://linkedin.com/in/prajwal\" }\n}" },
        "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api","profile"] }
      }
    },
    {
      "name": "2. Profile — GET (public)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api","profile"] } }
    },
    {
      "name": "3. Portfolio — GET aggregate (public)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));",
        "const j = pm.response.json();",
        "pm.test('has aggregate keys', () => { pm.expect(j.data).to.have.property('profile'); pm.expect(j.data).to.have.property('featuredProjects'); pm.expect(j.data).to.have.property('topSkills'); });"
      ] } } ],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/portfolio", "host": ["{{baseUrl}}"], "path": ["api","portfolio"] } }
    },
    {
      "name": "4. Guides — create (admin)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201', () => pm.expect(pm.response.code).to.eql(201));" ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"slug\": \"{{guideSlug}}\",\n  \"title\": \"How to use the Remote MCP Server\",\n  \"summary\": \"A quick start\",\n  \"bodyMd\": \"# Getting Started\\n\\nSteps here...\",\n  \"category\": \"mcp\",\n  \"isPublished\": true\n}" },
        "url": { "raw": "{{baseUrl}}/api/guides", "host": ["{{baseUrl}}"], "path": ["api","guides"] }
      }
    },
    {
      "name": "5. Guides — list (public)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/guides", "host": ["{{baseUrl}}"], "path": ["api","guides"] } }
    },
    {
      "name": "6. Guides — get by slug (public)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/guides/{{guideSlug}}", "host": ["{{baseUrl}}"], "path": ["api","guides","{{guideSlug}}"] } }
    },
    {
      "name": "7. Guides — update (admin)",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"How to use the Remote MCP Server (updated)\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/guides/{{guideSlug}}", "host": ["{{baseUrl}}"], "path": ["api","guides","{{guideSlug}}"] }
      }
    },
    {
      "name": "8. Guides — all incl. unpublished (admin)",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/api/guides/all", "host": ["{{baseUrl}}"], "path": ["api","guides","all"] } }
    },
    {
      "name": "9. Blogs — create published (admin)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201', () => pm.expect(pm.response.code).to.eql(201));" ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"slug\": \"{{blogSlug}}\",\n  \"title\": \"Hello World\",\n  \"excerpt\": \"My first post\",\n  \"contentMd\": \"# Hello\\n\\nContent...\",\n  \"tags\": [\"devops\", \"ai\"],\n  \"status\": \"published\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/blogs", "host": ["{{baseUrl}}"], "path": ["api","blogs"] }
      }
    },
    {
      "name": "10. Blogs — list published (public)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/blogs", "host": ["{{baseUrl}}"], "path": ["api","blogs"] } }
    },
    {
      "name": "11. Blogs — get by slug (public, +view)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));",
        "const j = pm.response.json();",
        "pm.test('views incremented', () => pm.expect(j.data.views).to.be.at.least(1));"
      ] } } ],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/blogs/{{blogSlug}}", "host": ["{{baseUrl}}"], "path": ["api","blogs","{{blogSlug}}"] } }
    },
    {
      "name": "12. Blogs — all incl. drafts (admin)",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/api/blogs/all", "host": ["{{baseUrl}}"], "path": ["api","blogs","all"] } }
    },
    {
      "name": "13. Guides — delete (admin, cleanup)",
      "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/api/guides/{{guideSlug}}", "host": ["{{baseUrl}}"], "path": ["api","guides","{{guideSlug}}"] } }
    },
    {
      "name": "14. Blogs — delete (admin, cleanup)",
      "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{adminToken}}" } ], "url": { "raw": "{{baseUrl}}/api/blogs/{{blogSlug}}", "host": ["{{baseUrl}}"], "path": ["api","blogs","{{blogSlug}}"] } }
    },
    {
      "name": "15. Admin guard — create guide WITHOUT token (expect 401)",
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('401', () => pm.expect(pm.response.code).to.eql(401));" ] } } ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"slug\": \"nope\",\n  \"title\": \"x\",\n  \"bodyMd\": \"x\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/guides", "host": ["{{baseUrl}}"], "path": ["api","guides"] }
      }
    }
  ]
}
