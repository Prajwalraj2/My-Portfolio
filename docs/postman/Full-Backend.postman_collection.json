        { "name": "GET /api/profile (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api","profile"] } } },
        { "name": "GET /api/portfolio (aggregate)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/portfolio", "host": ["{{baseUrl}}"], "path": ["api","portfolio"] } } }
      ]
