        { "name": "POST /api/github/refresh (admin)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/github/refresh", "host": ["{{baseUrl}}"], "path": ["api","github","refresh"] } } }
      ]
    },
    {
      "name": "13 Meetings (Cal.com)",
      "item": [
        {
          "name": "GET /slots (capture first slot)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const now=new Date();",
              "pm.collectionVariables.set('slotStart_q', new Date(now.getTime()+864e5).toISOString());",
              "pm.collectionVariables.set('slotEnd_q', new Date(now.getTime()+12096e5).toISOString());"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const j=pm.response.json(); const s=(j.data&&j.data.slots)||{}; const d=Object.keys(s);",
              "if(d.length&&s[d[0]].length){const f=s[d[0]][0]; pm.collectionVariables.set('slotStart', f.start||f.time);}"
            ] } }
          ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/meetings/slots?startTime={{slotStart_q}}&endTime={{slotEnd_q}}&timeZone={{timeZone}}", "host": ["{{baseUrl}}"], "path": ["api","meetings","slots"], "query": [ { "key": "startTime", "value": "{{slotStart_q}}" }, { "key": "endTime", "value": "{{slotEnd_q}}" }, { "key": "timeZone", "value": "{{timeZone}}" } ] } }
        },
        {
          "name": "POST / book (session; capture uid)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const j=pm.response.json(); if(j.data&&j.data.calUid) pm.collectionVariables.set('meetingUid', j.data.calUid);" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"start\": \"{{slotStart}}\",\n  \"name\": \"Full Test\",\n  \"email\": \"visitor@example.com\",\n  \"timeZone\": \"{{timeZone}}\",\n  \"topic\": \"E2E test booking\"\n}" }, "url": { "raw": "{{baseUrl}}/api/meetings", "host": ["{{baseUrl}}"], "path": ["api","meetings"] } }
        },
        { "name": "GET /mine (session)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/meetings/mine", "host": ["{{baseUrl}}"], "path": ["api","meetings","mine"] } } },
        { "name": "GET / (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/meetings", "host": ["{{baseUrl}}"], "path": ["api","meetings"] } } }
      ]
