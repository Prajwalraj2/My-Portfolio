{
  "info": {
    "name": "Portfolio API — FULL Backend (Phases 1–2)",
    "description": "End-to-end test of the entire gateway. Run with the Collection Runner top-to-bottom: it seeds an admin token + user session, then exercises every resource (public reads, admin CRUD lifecycles, submissions+notifications, meetings, keys, rate limiting). Prereqs: gateway running on :8000; admin seeded (pnpm seed:admin); Cal.com/Resend/Slack configured in .env; ai-service running for the Chat folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "userEmail", "value": "test@example.com" },
    { "key": "userPassword", "value": "password123" },
    { "key": "adminEmail", "value": "admin@prajwalraj.me" },
    { "key": "adminPassword", "value": "AdminPassword123!" },
    { "key": "adminToken", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "categorySlug", "value": "test-category" },
    { "key": "projectSlug", "value": "test-project" },
    { "key": "skillId", "value": "" },
    { "key": "experienceId", "value": "" },
    { "key": "testimonialId", "value": "" },
    { "key": "inquiryId", "value": "" },
    { "key": "resumeId", "value": "" },
    { "key": "guideSlug", "value": "test-guide" },
    { "key": "blogSlug", "value": "test-blog" },
    { "key": "timeZone", "value": "Asia/Kolkata" },
    { "key": "slotStart", "value": "" },
    { "key": "slotStart_q", "value": "" },
    { "key": "slotEnd_q", "value": "" },
    { "key": "meetingUid", "value": "" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        { "name": "GET /health", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } } },
        { "name": "GET /ready", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/ready", "host": ["{{baseUrl}}"], "path": ["ready"] } } }
      ]
    },
    {
      "name": "01 Auth — Admin (run first)",
      "item": [
        {
          "name": "POST /api/auth/admin/login (capture token)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));",
            "const j = pm.response.json(); if (j.data && j.data.accessToken) pm.collectionVariables.set('adminToken', j.data.accessToken);"
          ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","login"] } }
        },
        { "name": "GET /api/auth/admin/me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/auth/admin/me", "host": ["{{baseUrl}}"], "path": ["api","auth","admin","me"] } } }
      ]
    },
    {
      "name": "02 Auth — User",
      "item": [
        {
          "name": "POST /api/auth/signup (ok or 409 if exists)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"Test User\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","auth","signup"] } }
        },
        {
          "name": "POST /api/auth/login (sets sid cookie)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] } }
        },
        { "name": "GET /api/auth/me (session)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] } } }
      ]
    },
    {
      "name": "03 API Keys",
      "item": [
        {
          "name": "POST /api/apikeys (capture key)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201', () => pm.expect(pm.response.code).to.eql(201));",
            "const j = pm.response.json(); pm.collectionVariables.set('apiKey', j.data.key);"
          ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"full-test key\",\n  \"scopes\": [\"meetings:write\"]\n}" }, "url": { "raw": "{{baseUrl}}/api/apikeys", "host": ["{{baseUrl}}"], "path": ["api","apikeys"] } }
        },
        { "name": "GET /api/apikeys", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/apikeys", "host": ["{{baseUrl}}"], "path": ["api","apikeys"] } } },
        { "name": "GET /api/auth/me via API key", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }], "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] } } }
      ]
    },
    {
      "name": "04 Categories (admin CRUD)",
      "item": [
        {
          "name": "POST create (capture id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const j = pm.response.json(); if (j.data) pm.collectionVariables.set('categoryId', j.data.id);"
          ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Category\",\n  \"slug\": \"{{categorySlug}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api","categories"] } }
        },
        { "name": "GET / (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api","categories"] } } },
        { "name": "GET /:slug (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/categories/{{categorySlug}}", "host": ["{{baseUrl}}"], "path": ["api","categories","{{categorySlug}}"] } } },
        { "name": "PUT /:slug (admin)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"updated\"\n}" }, "url": { "raw": "{{baseUrl}}/api/categories/{{categorySlug}}", "host": ["{{baseUrl}}"], "path": ["api","categories","{{categorySlug}}"] } } }
      ]
    },
    {
      "name": "05 Projects (admin CRUD)",
      "item": [
        {
          "name": "POST create (needs categoryId)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"slug\": \"{{projectSlug}}\",\n  \"title\": \"Test Project\",\n  \"description\": \"A test\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"techStack\": [\"TypeScript\"],\n  \"isFeatured\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api","projects"] } }
        },
        { "name": "GET / (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api","projects"] } } },
        { "name": "GET /featured", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/projects/featured", "host": ["{{baseUrl}}"], "path": ["api","projects","featured"] } } },
        { "name": "GET /:slug", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/projects/{{projectSlug}}", "host": ["{{baseUrl}}"], "path": ["api","projects","{{projectSlug}}"] } } },
        { "name": "PUT /:slug (admin)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test Project (updated)\"\n}" }, "url": { "raw": "{{baseUrl}}/api/projects/{{projectSlug}}", "host": ["{{baseUrl}}"], "path": ["api","projects","{{projectSlug}}"] } } },
        { "name": "DELETE /:slug (admin)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/projects/{{projectSlug}}", "host": ["{{baseUrl}}"], "path": ["api","projects","{{projectSlug}}"] } } }
      ]
    },
    {
      "name": "06 Skills (admin CRUD)",
      "item": [
        {
          "name": "POST create (capture id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const j = pm.response.json(); if (j.data) pm.collectionVariables.set('skillId', j.data.id);" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Kubernetes\",\n  \"category\": \"devops\",\n  \"proficiency\": 90,\n  \"isFeatured\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/skills", "host": ["{{baseUrl}}"], "path": ["api","skills"] } }
        },
        { "name": "GET / (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/skills", "host": ["{{baseUrl}}"], "path": ["api","skills"] } } },
        { "name": "GET /grouped", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/skills/grouped", "host": ["{{baseUrl}}"], "path": ["api","skills","grouped"] } } },
        { "name": "PUT /:id (admin)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"proficiency\": 95\n}" }, "url": { "raw": "{{baseUrl}}/api/skills/{{skillId}}", "host": ["{{baseUrl}}"], "path": ["api","skills","{{skillId}}"] } } },
        { "name": "DELETE /:id (admin)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/skills/{{skillId}}", "host": ["{{baseUrl}}"], "path": ["api","skills","{{skillId}}"] } } }
      ]
    },
    {
      "name": "07 Experience (admin CRUD)",
      "item": [
        {
          "name": "POST create (capture id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const j = pm.response.json(); if (j.data) pm.collectionVariables.set('experienceId', j.data.id);" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"company\": \"Enov8\",\n  \"role\": \"Engineer\",\n  \"startDate\": \"2024-01-01\",\n  \"isCurrent\": true,\n  \"techStack\": [\"AWS\"]\n}" }, "url": { "raw": "{{baseUrl}}/api/experience", "host": ["{{baseUrl}}"], "path": ["api","experience"] } }
        },
        { "name": "GET / (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/experience", "host": ["{{baseUrl}}"], "path": ["api","experience"] } } },
        { "name": "GET /current", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/experience/current", "host": ["{{baseUrl}}"], "path": ["api","experience","current"] } } },
        { "name": "DELETE /:id (admin)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/experience/{{experienceId}}", "host": ["{{baseUrl}}"], "path": ["api","experience","{{experienceId}}"] } } }
      ]
    },
    {
      "name": "08 Resume (admin CRUD)",
      "item": [
        {
          "name": "POST /versions (capture id)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const j = pm.response.json(); if (j.data) pm.collectionVariables.set('resumeId', j.data.id);" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"version\": \"v1\",\n  \"label\": \"2026\",\n  \"s3Url\": \"https://example.com/resume.pdf\",\n  \"isDefault\": true\n}" }, "url": { "raw": "{{baseUrl}}/api/resume/versions", "host": ["{{baseUrl}}"], "path": ["api","resume","versions"] } }
        },
        { "name": "GET / (public default)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/resume", "host": ["{{baseUrl}}"], "path": ["api","resume"] } } },
        { "name": "GET /download (public)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/resume/download", "host": ["{{baseUrl}}"], "path": ["api","resume","download"] } } },
        { "name": "GET /stats (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/resume/stats", "host": ["{{baseUrl}}"], "path": ["api","resume","stats"] } } }
      ]
