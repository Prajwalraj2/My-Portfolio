          "name": "Create key limit=2 (capture)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const j=pm.response.json(); pm.collectionVariables.set('rlKey', j.data.key);" ] } } ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"rl\",\n  \"rateLimitPerHour\": 2\n}" }, "url": { "raw": "{{baseUrl}}/api/apikeys", "host": ["{{baseUrl}}"], "path": ["api","apikeys"] } }
