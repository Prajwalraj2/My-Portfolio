        { "name": "GET / (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/inquiries", "host": ["{{baseUrl}}"], "path": ["api","inquiries"] } } },
        { "name": "GET /stats (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/inquiries/stats", "host": ["{{baseUrl}}"], "path": ["api","inquiries","stats"] } } },
        { "name": "POST /:id/close (admin)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/inquiries/{{inquiryId}}/close", "host": ["{{baseUrl}}"], "path": ["api","inquiries","{{inquiryId}}","close"] } } },
        { "name": "DELETE /:id (admin cleanup)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/inquiries/{{inquiryId}}", "host": ["{{baseUrl}}"], "path": ["api","inquiries","{{inquiryId}}"] } } }
