        { "name": "DELETE /:slug (admin)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{baseUrl}}/api/blogs/{{blogSlug}}", "host": ["{{baseUrl}}"], "path": ["api","blogs","{{blogSlug}}"] } } }
