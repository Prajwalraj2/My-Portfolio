          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acme Corp\",\n  \"email\": \"hiring@acme.com\",\n  \"description\": \"We want to build an internal AI tool.\"\n}" }, "url": { "raw": "{{baseUrl}}/api/inquiries", "host": ["{{baseUrl}}"], "path": ["api","inquiries"] } }
