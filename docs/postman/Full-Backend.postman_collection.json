        { "name": "POST /api/chat/complete", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"messages\": [ { \"role\": \"user\", \"content\": \"Tell me about Prajwal's projects.\" } ]\n}" }, "url": { "raw": "{{baseUrl}}/api/chat/complete", "host": ["{{baseUrl}}"], "path": ["api","chat","complete"] } } }
