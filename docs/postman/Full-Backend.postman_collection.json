        { "name": "key call #2 (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{rlKey}}" }], "url": { "raw": "{{baseUrl}}/api/github", "host": ["{{baseUrl}}"], "path": ["api","github"] } } },
        { "name": "key call #3 (429)", "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('429', () => pm.expect(pm.response.code).to.eql(429));" ] } } ], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{rlKey}}" }], "url": { "raw": "{{baseUrl}}/api/github", "host": ["{{baseUrl}}"], "path": ["api","github"] } } },
